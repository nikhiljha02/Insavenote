{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://insavenote.onrender.com/api/$1"
    },
    {
      "source": "/note/(.*)",
      "destination": "https://insavenote.onrender.com/note/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
